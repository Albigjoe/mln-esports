// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("upcoming")
  startDate   DateTime
  endDate     DateTime?
  bannerUrl   String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  games       Game[]
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeGames   Game[]  @relation("HomeTeam")
  awayGames   Game[]  @relation("AwayTeam")
  players     Player[]
  awards      Award[] @relation("TeamAwards")
}

model Game {
  id            String   @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id])

  team1Id       String
  team1         Team       @relation("HomeTeam", fields: [team1Id], references: [id])
  team2Id       String
  team2         Team       @relation("AwayTeam", fields: [team2Id], references: [id])

  winner        String   @default("")
  week          Int      @default(1)
  gameNumber    Int      @default(1)
  date          String   @default("")
  boFormat      Int      @default(1)
  duration      String   @default("")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bans          Ban[]
  picks         Pick[]
  disputes      Dispute[]
}

model Ban {
  id        String @id @default(cuid())
  gameId    String
  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  team      String
  hero      String
  banOrder  Int
}

model Pick {
  id              String @id @default(cuid())
  gameId          String
  game            Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  team            String
  hero            String
  playerUsername  String @default("")
  role            String @default("")
  kills           Int    @default(0)
  deaths          Int    @default(0)
  assists         Int    @default(0)
  gold            Int    @default(0)
  damage          Int    @default(0)
  savages         Int    @default(0)
  maniacs         Int    @default(0)
  tfp             Float  @default(0)
  mvpScore        Float  @default(0)
  isMvp           Boolean @default(false)
  pickOrder       Int    @default(0)
}

model AdminUser {
  id        String @id @default(cuid())
  email     String @unique
  password  String
  name      String
  role      String @default("staff") // admin, staff
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String   @default("")
  category    String   @default("news") // news, transfer, announcement, recap
  imageUrl    String?
  published   Boolean  @default(false)
  authorName  String   @default("MLN Staff")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Award {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  season      String   @default("")
  imageUrl    String?
  playerId    String?
  player      Player?  @relation(fields: [playerId], references: [id])
  teamId      String?
  team        Team?    @relation("TeamAwards", fields: [teamId], references: [id])
  createdAt   DateTime @default(now())
}

model Player {
  id          String   @id @default(cuid())
  username    String   @unique
  pictureUrl  String?
  realName    String?
  role        String   @default("PLAYER") // PLAYER, CAPTAIN
  state       String   @default("Lagos")  // For Lagos, Abuja, Rivers regional leaderboards
  rank        String   @default("Epic")   // MLBB rank
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id])
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  awards      Award[]
  disputes    Dispute[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String
  role            String           @default("PLAYER") // PLAYER, ADMIN
  kycStatus       String           @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  player          Player?
  wallet          Wallet?
  kycVerification KycVerification?
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Decimal  @default(0.0) // In Naira (NGN)
  currency      String   @default("NGN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  Transaction[]
}

model Transaction {
  id            String   @id @default(cuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount        Decimal
  type          String   // DEPOSIT, WITHDRAW, ENTRY_FEE, PRIZE_CLAIM
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  reference     String   @unique // Paystack or Flutterwave transaction reference
  gateway       String   @default("PAYSTACK") // PAYSTACK, FLUTTERWAVE
  createdAt     DateTime @default(now())
}

model KycVerification {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idType        String   // NIN, BVN, Passport
  idNumber      String
  idImageUrl    String
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
}

model Dispute {
  id            String   @id @default(cuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  screenshotUrl String
  reason        String
  status        String   @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED
  resolvedBy    String?
  createdAt     DateTime @default(now())
}

model ScrimRequest {
  id              String   @id @default(cuid())
  challengerTeamId String
  receiverTeamId   String
  status          String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  scheduledFor    DateTime
  createdAt       DateTime @default(now())
}

